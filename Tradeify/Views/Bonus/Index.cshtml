@model Core.ViewModels.MatchingViewModel
@{
    ViewData["Title"] = "RegBonus";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}


<div class="payment_transfer_Wrapper float_left">
    <div class="row">
        <div class="col-md-12 col-lg-12 col-sm-12 col-12"></div>

        <div class="col-md-12 col-lg-12 col-sm-12 col-12">
            <div class="sv_heading_wraper heading_center">
                <h3>Pay Reg Bonus</h3>
            </div>
        </div>
    </div>



    <div class="row">
        <div class="col-md-12 col-xl-6 offset-xl-3 col-lg-8 offset-lg-2 col-sm-12 col-12">
            <div class="change_password_wrapper float_left">
                <br />
                <div class="change_pass_field float_left">
                    <div class="form-group">
                        <label class="col-form-label w-100">Users</label>
                        <select data-placeholder="Select User " style="width: 100% " id="userIds" name="userIds"
                                asp-items="@(new SelectList(ViewBag.UsersInBonus ,"Id", "FirstName" ))"
                                multiple class="form-control w-100 multiSelect" required>
                        </select>
                    </div>
                    
                    <span class="about_btn float_left ">
                        <button type="button" onclick="sendBonusesToUsers()" class=" p-3 all-radius bg-warning">
                            Pay Bonuses
                        </button>
                        
                    </span>
                </div>
            </div>
        </div>
    </div>

</div>
